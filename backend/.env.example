# generate a free one from neon.new, if need be, has a 72hr limit without an account tho, keep in mind
DATABASE_URL=postgresql://YOUR_POSTGRES_DEV_DB_URL_HERE

# Keep this 3000, unless you are feeling zesty or smth, idk
PORT=3000

# You can use this to generate a cryptographically safe string:
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=64_char_long_randomly_generated_string_here

# expiry for JWT Token
JWT_EXPIRES_IN=3d

# number of rounds to salt the tokens for
BCRYPT_ROUNDS=12
